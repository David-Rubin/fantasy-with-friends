rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // App-level role. Folded into the membership helpers below rather than
    // repeated at every rule, so a superadmin can reach any league or season
    // without being a member of it. Deliberately NOT folded into the rules that
    // are closed to everybody — picks, audit logs, granting the role itself —
    // since those are not actions any user can take either.
    function isSuperadmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }

    function isLeagueMember(leagueId) {
      return isSignedIn() && (
        isSuperadmin() ||
        exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid))
      );
    }

    function leagueMemberRole(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid)).data.role;
    }

    function isLeagueAdmin(leagueId) {
      return isSuperadmin() || (
        isLeagueMember(leagueId) && leagueMemberRole(leagueId) in ['owner', 'admin']
      );
    }

    function isLeagueOwner(leagueId) {
      return isSuperadmin() || (
        isLeagueMember(leagueId) && leagueMemberRole(leagueId) == 'owner'
      );
    }

    function isSeasonMember(seasonId) {
      return isSignedIn() && (
        isSuperadmin() ||
        exists(/databases/$(database)/documents/seasons/$(seasonId)/members/$(request.auth.uid))
      );
    }

    function seasonLeagueId(seasonId) {
      return get(/databases/$(database)/documents/seasons/$(seasonId)).data.leagueId;
    }

    function isSeasonAdmin(seasonId) {
      return isLeagueAdmin(seasonLeagueId(seasonId));
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth.uid == uid;
      // Own document only, and no delete for anyone — a superadmin deletes an
      // account through the deleteUser function, which also has to reach the
      // Auth record, the superadmins document, and every membership the user
      // holds across leagues and seasons. None of that is visible from here.
      // No credential ever belongs in this document. Firebase Authentication
      // holds the password as a salted hash and nothing here needs to see it,
      // so a write carrying anything password-shaped is refused outright rather
      // than trusted to be harmless.
      allow create, update: if request.auth.uid == uid
        && !('pinHash' in request.resource.data)
        && !('pin' in request.resource.data)
        && !('password' in request.resource.data)
        && !('passwordHash' in request.resource.data);
      allow delete: if false;
    }

    // ── Superadmins ───────────────────────────────────────────────────────────
    // App-level role, distinct from the per-league owner/admin/member roles.
    // Deliberately its own collection rather than a field on /users: that
    // document is self-writable, so a flag there would let anyone promote
    // themselves. Reading is limited to your own record, which is all the client
    // needs to decide whether to show the link.
    //
    // There is no UI for granting — `allow write: if false` means not even a
    // superadmin can create another from the app. Add a document keyed by the
    // user's uid out of band: the Firestore console in production, or against
    // the emulator with
    //   curl -X POST "$FIRESTORE/superadmins?documentId=<uid>" \
    //     -H "Authorization: Bearer owner" -H "Content-Type: application/json" \
    //     -d '{"fields":{"grantedAt":{"integerValue":"0"}}}'
    // The document's contents are never read; its existence is the grant.
    match /superadmins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Collection group: a user's own membership docs ────────────────────────
    // The dashboard runs collectionGroup(db, 'members') to find every league the
    // signed-in user belongs to. Nested `match /leagues/{id}/members/{uid}` rules
    // do NOT authorize collection group queries — that needs a {path=**} match.
    // Scoped to the caller's own uid, so this leaks nothing about other users.
    match /{path=**}/members/{uid} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.uid;
    }

    // ── Collection group: a user's own join requests ──────────────────────────
    // The dashboard lists every league, and each row's button depends on whether
    // this user already has a request open for it. One collectionGroup query
    // answers that for all leagues at once; like the members rule above it needs
    // a {path=**} match and a filter on the caller's own uid.
    match /{path=**}/joinRequests/{uid} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.uid;
    }

    // ── Leagues ───────────────────────────────────────────────────────────────
    match /leagues/{leagueId} {
      // Every signed-in user browses every league from the dashboard and can
      // open a league page before joining, so the league document itself is
      // public to signed-in users. What stays closed is everything under it:
      // the roster, and all season data. `memberCount` exists precisely so a
      // non-member can size up a league without reading its members.
      allow read: if isSignedIn();
      // memberCount is derived state, owned by the onLeagueMemberWritten
      // trigger. A client that could seed or edit it could inflate a league's
      // apparent size, so it starts at 0 and is immutable to clients — the
      // trigger writes through the Admin SDK and is not bound by these rules.
      allow create: if isSignedIn() && request.resource.data.memberCount == 0;
      allow update: if isLeagueAdmin(leagueId)
        && request.resource.data.memberCount == resource.data.memberCount;
      // Closed to clients even for the owner, who *can* delete a league — but
      // only through the deleteLeague function. A league is a tree: members,
      // joinRequests, and every season keyed by leagueId in a separate
      // top-level collection. Deleting just this document from the client left
      // all of it orphaned and unreachable, since every rule below reads this
      // document to decide who may see them.
      allow delete: if false;

      match /members/{uid} {
        allow read: if isLeagueMember(leagueId);
        // Bootstrap: right after creating a league the owner writes their own
        // membership doc. At that instant no member docs exist, so isLeagueOwner()
        // — which calls exists() on this very document — can never be satisfied.
        // Authorize off the league's ownerId instead, for the caller's own uid only.
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && get(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerId == request.auth.uid;
        // Role changes (promote/demote) are owner-only, as is admitting a new
        // member — approveJoinRequest writes this document and the request's
        // status in one batch.
        allow create, update: if isLeagueOwner(leagueId);
        // Removal goes through the removeLeagueMember Cloud Function, never the
        // client. Whether a member may be removed depends on whether they are
        // sitting in a season that is drafting or active — a query across the
        // seasons collection plus a document read in each, neither of which a
        // rule can do. Allowing the delete here would make that check advice
        // rather than a constraint, and a member deleted mid-draft leaves a
        // pick order pointing at nobody.
        allow delete: if false;
      }

      // ── Join requests ───────────────────────────────────────────────────────
      // Keyed by the requester's uid, so a user cannot queue up duplicates.
      match /joinRequests/{uid} {
        allow read: if isLeagueOwner(leagueId) || (isSignedIn() && request.auth.uid == uid);

        // A requester writes only their own document, and only as a fresh
        // pending request — the decision fields are not theirs to set. Update is
        // allowed on the same terms so someone who was rejected can ask again by
        // overwriting their old request.
        //
        // Membership is tested with exists() rather than isLeagueMember(): a
        // superadmin has effective access to every league without belonging to
        // any, and must still be able to ask to join one as an ordinary player.
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.decidedAt == null
          && request.resource.data.decidedBy == null
          && !exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(uid));

        // The owner decides. Rejected requests are kept rather than deleted so
        // the queue keeps its history.
        allow update: if isLeagueOwner(leagueId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.status in ['approved', 'rejected'];
        allow delete: if isLeagueOwner(leagueId);
      }
    }

    // A season stops being tunable once it has been scored. Expressed here
    // rather than left to the client: it is a single get() on the parent
    // season, which is exactly the kind of check a rule can make.
    function seasonState(seasonId) {
      return get(/databases/$(database)/documents/seasons/$(seasonId)).data.state;
    }

    // Whether a season has anything scored against it yet. Absent on season
    // documents written before the field existed, which read as unscored.
    function seasonIsUnscored(seasonId) {
      return seasonState(seasonId) != 'complete'
        && get(/databases/$(database)/documents/seasons/$(seasonId))
             .data.get('firstEpisodeScoredAt', null) == null;
    }

    // ── Seasons ───────────────────────────────────────────────────────────────
    match /seasons/{seasonId} {
      // A league page is readable before joining and lists that league's
      // seasons, so the season document is open to any signed-in user. Only this
      // document — every subcollection below (roster, contestants, picks,
      // scores, draft) stays gated on season membership, and the season page
      // itself refuses to render for a non-member.
      //
      // Note this exposes teamTotals / teamEpisodeTotals, which are point totals
      // keyed by uid. No names are attached, and the display names that would
      // make them meaningful live in the members subcollection, which is closed.
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
        isLeagueAdmin(request.resource.data.leagueId);
      // teamTotals / teamEpisodeTotals are written only by Cloud Functions (Admin SDK)
      allow update: if isSeasonAdmin(seasonId);
      // Closed to clients for the same reason as the league above: a season
      // owns members, contestants, scoringRules, episodeScores with their
      // nested contestantScores, and a draft with its picks. A rule cannot
      // enumerate them, so the cascade belongs to the deleteSeason function.
      allow delete: if false;

      match /members/{uid} {
        allow read: if isSeasonMember(seasonId);
        // Team name update — own record only, and only while the season has
        // nothing scored against it.
        //
        // That is the closest durable line to the product rule, which is that
        // naming happens in the draft room: before the draft opens, while it
        // runs, and while the "Draft complete!" banner is still up. The draft
        // ending moves the season to `active` in the same write, so `state`
        // alone cannot tell a member reading that banner from one who came
        // back in week six — but a scored episode can, and by then the name is
        // on a leaderboard people are reading. See src/lib/teamName.ts, which
        // draws the same line for the field the draft room offers.
        //
        // The length bound is enforced here rather than left to the client: a
        // name too long for a leaderboard row is everyone else's problem, not
        // only the writer's. It must match TEAM_NAME_MAX_LENGTH in
        // src/lib/teamName.ts; src/lib/rulesLimits.test.ts fails if it does not.
        allow update: if request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamName'])
          && request.resource.data.teamName is string
          && request.resource.data.teamName.size() > 0
          && request.resource.data.teamName.size() <= 40
          && seasonIsUnscored(seasonId);

        // A league member joins a season for themselves, while it is still
        // being set up. No approval: they are already in the league, and pick
        // order does not exist until the draft is randomized, so an arrival now
        // is indistinguishable from one who was there when the season was
        // created. Without this a member admitted to the league after a season
        // began had no way in at all, and no control anywhere to ask for one.
        //
        // A rule rather than a Cloud Function because a rule can decide all of
        // it: one get() for the season's state, one exists() for the league
        // roster. `create` only, so an existing membership — with its pick
        // position and team name — can never be overwritten this way.
        //
        // pickPosition is pinned to null because that is the only honest value
        // before a draft is randomized; the position itself is assigned by an
        // admin. displayName is not checked against the league roster: it is
        // copied from the joiner's own self-writable user document everywhere
        // else in the app, so a check here would guard nothing.
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.pickPosition == null
          && seasonState(seasonId) == 'setup'
          && isLeagueMember(seasonLeagueId(seasonId));

        // Adding anyone else, and assigning pick positions, stays with admins.
        allow write: if isSeasonAdmin(seasonId);
      }

      match /contestants/{contestantId} {
        allow read: if isSeasonMember(seasonId);
        allow write: if isSeasonAdmin(seasonId);
      }

      match /scoringRules/{ruleId} {
        allow read: if isSeasonMember(seasonId);
        // Editable at any point in a season. A show changes its own rules
        // mid-run, so a league has to be able to follow — the old cutoff at the
        // first scored episode meant a season could be wrong for the rest of its
        // life.
        //
        // What that cutoff protected is handled instead by never rewriting a
        // recorded score behind anyone's back: an episode already submitted and
        // locked keeps the totals it was given, and an admin re-applies the new
        // rules to it deliberately, from that episode's own page.
        allow write: if isSeasonAdmin(seasonId);
      }

      match /episodeScores/{episodeNumber} {
        allow read: if isSeasonMember(seasonId);
        allow write: if isSeasonAdmin(seasonId);

        match /contestantScores/{contestantId} {
          allow read: if isSeasonMember(seasonId);
          allow write: if isSeasonAdmin(seasonId);
        }
      }

      // A scorecard filled in by a member for an admin to decide on.
      //
      // Kept out of episodeScores on purpose. onEpisodeScoreWritten recomputes
      // every team total from episodeScores/{n}/contestantScores, so a
      // suggestion stored under that path would move the leaderboard the
      // moment it was saved. Here nothing watches, and nothing is scored until
      // an admin writes the real document.
      //
      // A rule can decide all of this, so no callable is needed: one exists()
      // for whether the episode has already been scored, and the rest is the
      // shape of the incoming document.
      match /scoreProposals/{episodeNumber} {
        allow read: if isSeasonMember(seasonId);

        // Members may offer a card, but only for an episode nobody has scored,
        // only as themselves, and only when there is no live suggestion to
        // overwrite — the last writer would otherwise silently replace everyone
        // before them, and the admin would never know they disagreed. A
        // discarded one may be replaced: the reset reopened the episode.
        allow create, update: if isSeasonMember(seasonId)
          && request.auth.uid == request.resource.data.submittedBy
          && request.resource.data.status == 'pending'
          && !exists(/databases/$(database)/documents/seasons/$(seasonId)/episodeScores/$(episodeNumber))
          && (resource == null || resource.data.status == 'discarded');

        // Deciding on it — approving or resetting — belongs to an admin, who is
        // also the only one who may take it out of `pending`.
        allow write: if isSeasonAdmin(seasonId);
      }

      match /draft/{draftId} {
        allow read: if isSeasonMember(seasonId);
        // Written only by Cloud Functions through the Admin SDK — startDraft
        // opens it, submitPick and resolveExpiredTurn move it on, setTimerPaused
        // stops and restarts its clock.
        //
        // Closed to clients because of `timerExpiresAt`. It is an absolute
        // timestamp that the server measures against its own clock, so a
        // browser writing it puts two clocks in the same field: an admin whose
        // machine ran five seconds fast opened the board with a deadline five
        // seconds further out than the season allowed, and pausing a 60 second
        // timer at 56 banked 61. No rule can check a timestamp against the time
        // — that is exactly what a rule cannot see — so the write has to happen
        // where the clock is.
        allow write: if false;

        match /picks/{pickId} {
          allow read: if isSeasonMember(seasonId);
          // Picks are written only by the submitPick Cloud Function via the
          // Admin SDK. Rules cannot validate a pick on their own: deriving the
          // next picker means re-implementing snake order here, and detecting a
          // finished board needs an aggregate rules cannot compute. Letting the
          // client write directly would mean trusting it on both.
          allow write: if false;
        }
      }
    }

    // ── App config ────────────────────────────────────────────────────────────
    // Holds the one-shot marker recording that the first account has already
    // been made superadmin. Closed to clients entirely — a client that could
    // delete it could re-arm the grant and take the role by signing up again.
    match /appConfig/{docId} {
      allow read, write: if false;
    }

    // ── Audit Logs ────────────────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if false;
      allow write: if false; // written only via Admin SDK in Cloud Functions
    }
  }
}
