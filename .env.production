# Production Firebase config for the `real-tv-draft` project.
#
# Committed on purpose. A Firebase web config is public by design — it ships
# inside the JS bundle that every visitor downloads, and it identifies the
# project rather than authorising anything. Access control is firestore.rules
# and the Cloud Functions, not this file. Keeping it in the repo means the
# values a given build used are visible in the diff.
#
# Vite loads .env.local in every mode and it wins over this file, so a correct
# production build only comes out where no .env.local exists — which is CI.
# For a one-off local production build, move .env.local aside first.
#
# VITE_USE_EMULATOR is deliberately absent: a production build could not connect
# to an emulator anyway (src/lib/firebase.ts gates that on import.meta.env.DEV),
# and saying nothing is clearer than saying false.
#
# VITE_TAB_SCOPED_AUTH is deliberately absent too — production keeps Firebase's
# default shared-across-tabs session. See CLAUDE.md.

VITE_FIREBASE_API_KEY=AIzaSyDPMsZs3gmH1gxAvfptzLvYfoXIxXhfyUg
VITE_FIREBASE_AUTH_DOMAIN=real-tv-draft.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=real-tv-draft
VITE_FIREBASE_STORAGE_BUCKET=real-tv-draft.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=337158785440
VITE_FIREBASE_APP_ID=1:337158785440:web:9d668d00dc5b25b7ddfcc5
VITE_FIREBASE_MEASUREMENT_ID=G-37ELLV9DQD
