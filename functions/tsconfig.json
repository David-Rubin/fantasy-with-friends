{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2021",
    "resolveJsonModule": true
  },
  "compileOnSave": true,
  "include": ["src"],
  // Tests run under the root vitest config, which owns the vitest types and
  // never ships to Cloud Functions.
  "exclude": ["src/**/*.test.ts"]
}
